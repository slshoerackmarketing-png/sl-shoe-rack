---
import { waLink } from '../lib/whatsapp.ts';
import Icon from './Icon.astro';
---
<a class="fab" href={waLink()} target="_blank" rel="noopener" aria-label="Chat on WhatsApp" data-fab>
  <Icon name="whatsapp" size={30} />
</a>
<style>
  .fab {
    position: fixed;
    right: calc(16px + env(safe-area-inset-right));
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 40;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--wa-green);
    color: var(--white);
    box-shadow: 0 6px 18px -6px rgb(34 39 43 / 0.45);
    transition:
      transform var(--t-std) var(--ease-out),
      opacity var(--t-std) var(--ease-out);
  }
  .fab:hover {
    color: var(--white);
    transform: scale(1.05);
  }
  .fab:active {
    transform: scale(0.95);
  }
  /* Hidden while the enquiry form or footer is on screen so it never covers controls or text. */
  .fab.is-away {
    opacity: 0;
    transform: translateY(12px) scale(0.9);
    pointer-events: none;
    visibility: hidden;
    transition:
      transform var(--t-std) var(--ease-out),
      opacity var(--t-std) var(--ease-out),
      visibility 0s var(--t-std);
  }
</style>
<script>
  const fab = document.querySelector<HTMLElement>('[data-fab]');
  const zones = document.querySelectorAll('[data-fab-away]');
  if (fab && zones.length && 'IntersectionObserver' in window) {
    const onScreen = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.isIntersecting ? onScreen.add(e.target) : onScreen.delete(e.target);
      fab.classList.toggle('is-away', onScreen.size > 0);
    });
    zones.forEach((z) => io.observe(z));
  }
</script>
