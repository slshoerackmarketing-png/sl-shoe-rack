// Only used if the site is deployed as a Cloudflare Worker (static assets).
// Cloudflare Pages ignores this file and uses its own build settings.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "sl-shoe-rack",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
